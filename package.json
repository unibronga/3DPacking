{
  "name": "3dpacking",
  "productName": "3DPacking",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "3DPacking — a 3D storage planner: containers and things in 3D, manual placement and tight automatic packing",
  "author": "Kostiantyn",
  "license": "MIT",
  "homepage": "https://github.com/unibronga/3DPacking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unibronga/3DPacking.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5288",
    "build": "vite build",
    "preview": "vite preview --port 5288",
    "icon": "electron scripts/prepare-icon.cjs",
    "desktop": "npm run build && electron .",
    "app": "npm run build && electron-builder --mac --dir --publish never",
    "dist": "npm run icon && npm run build && electron-builder --mac --publish never",
    "i18n": "node scripts/i18n-keys.mjs --check",
    "catalog": "cp \"$HOME/AI_Projects/разное/3dpacking-catalog/output/catalog.csv\" src/data/catalog.csv",
    "release:mac": "scripts/release-mac.sh"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  }
}
